# =============================================================================
# 4. PACKAGE MANAGERS
# =============================================================================
# Package manager files and lock files (some may be intentionally committed)

# npm / Node
package-lock.json
yarn.lock
pnpm-lock.yaml

# Python / pip
pip-log.txt
pip-delete-this-directory.txt
.pip/
# Poetry
poetry.lock

# Bundler / Ruby
Gemfile.lock

# Cargo / Rust
Cargo.lock

# Composer / PHP
composer.lock

# Conan / C++
conanfile.txt
conaninfo.txt
conanbuild.txt
conanvisualstudio.dll

# vcpkg
vcpkg_installed/


# =============================================================================
# 5. BUILD OUTPUTS AND COMPILED FILES
# =============================================================================
# Directories and files generated by build processes

# Build directories
dist/
build/
out/
target/
bin/
obj/
# Documentation output
docs/_build/
site/
# Coverage reports output
coverage/
.nyc_output/
# TypeScript
*.tsbuildinfo
# SASS/CSS compiled output
*.css.map
# Minified files (usually generated)
*.min.js
*.min.css
# Bundled files (webpack, rollup, etc.)
bundle.js
bundle.css


# =============================================================================
# 6. ENVIRONMENT AND SECRETS
# =============================================================================
# Files containing sensitive information or environment configurations
# IMPORTANT: Never commit secrets, API keys, or credentials!

# Environment variables files
.env
.env.local
.env.*.local
# Python virtual env activation script
venv/bin/activate
# Node environment
.node_repl_history
# AWS credentials
*.pem
# Google Cloud credentials
*.json
# Azure credentials
*.publishsettings
# Heroku
.env
# Terraform
*.tfstate
*.tfstate.*
# Ansible
*.retry
# Docker
.env
docker-compose.override.yml
# Misc secrets
credentials.json
secrets.yaml
*.secret


