# =============================================================================
# Test files, coverage reports, and debugging tools

# Test directories and files
coverage/
.nyc_output/
htmlcov/
# Jest
coverage/
# Vitest
coverage/
# Mocha
.nyc_output/
# Istanbul
coverage/
# Coveralls
coverage/
# Python coverage
.coverage
.coverage.*
htmlcov/
# Test results
test-results/
# Benchmark results
benchmark/*.json
benchmark/benchmarks/


# =============================================================================
# 8. DOCUMENTATION AND ASSETS
# =============================================================================
# Documentation build outputs and large asset files

# Generated documentation
site/
docs/_site/
# Large media files (if tracked separately)
# *.mp4
# *.zip
# *.tar.gz


# =============================================================================
# 9. PROJECT-SPECIFIC
# =============================================================================
# Add your project-specific ignore rules below

# Jekyll drafts and future posts
_drafts/
# Local development files
local/
# Any custom local configuration
_config.local.yml
# Jupyter notebooks checkpoints
.ipynb_checkpoints/
# Python notebook outputs
*.ipynb_checkpoints/
# Talk map outputs (from your project)
talkmap_out.ipynb
# Docker
.dockerignore
# Kubernetes
*.kubeconfig


# =============================================================================
# END OF .GITIGNORE
# =============================================================================
# Remember to run `git check-ignore -v <file>` to test patterns
# Use `git ls-files --others --ignored --exclude-standard` to see what's ignored
# =============================================================================
