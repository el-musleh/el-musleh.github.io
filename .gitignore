# =============================================================================
# COMPREHENSIVE .GITIGNORE - BEST PRACTICES
# =============================================================================
# This .gitignore follows current best practices and is designed to handle
# various project types, development environments, frameworks, languages,
# IDEs, operating systems, and build outputs.
#
# ORGANIZATION:
# 1. Operating System Files
# 2. IDEs and Editors
# 3. Language-Specific (Node.js, Python, Ruby/Jekyll, Java, Go, Rust, etc.)
# 4. Package Managers
# 5. Build Outputs and Compiled Files
# 6. Environment and Secrets
# 7. Testing and Coverage
# 8. Documentation and Assets
# 9. Project-Specific
#
# Customize this file based on your project requirements. Remove sections
# that don't apply to your project, or add custom patterns as needed.
# =============================================================================

# =============================================================================
# 1. OPERATING SYSTEM FILES
# =============================================================================
# Platform-specific temporary files that should never be committed

# macOS
# --------
# macOS system files - created when accessing directories in Finder
.DS_Store
# AppleDouble files - created by macOS when storing resource forks
._*
# Spotlight search index
.Spotlight-V100
# Trash folder metadata
.Trashes
# Volume icon (can appear on removable media)
.VolumeIcon.icns
# Temporary items
*~

# Windows
# --------
# Windows thumbnail cache
Thumbs.db
Thumbs.db:encryptable
# Windows error logs
ehthumbs.db
ehthumbs_vista.db
# Windows log files
*.log
# Windows temporary files
*.tmp
# Recycle bin
$RECYCLE.BIN/
# Desktop.ini (stores folder view settings)
Desktop.ini

# Linux
# --------
# Core dumps (often created when programs crash)
core
# Backup files ending with ~
*~
# Backup files ending with #
\#*#
# Automatic backup files
*.bak
# Temporary files
*.swp
*.swo
*~
# Midnight Commander (file manager) backup files
.*.sw[p]


# =============================================================================
# 2. IDEs AND EDITORS
# =============================================================================
# Development environment files that are personal preferences
# and should not be committed to shared repositories

# VS Code
# --------
# VS Code workspace settings (user-specific)
.vscode/*
# Exception: Keep these if you want to share editor settings
# !.vscode/settings.json
# !.vscode/tasks.json
# !.vscode/launch.json
# VS Code extensions
.vscode/extensions.json
# VS Code recommended settings
.vscodeignore

# JetBrains IDEs (IntelliJ, WebStorm, PyCharm, etc.)
# --------
# JetBrains IDE workspace files
.idea/
# JetBrains module files
*.iml
# JetBrains out directory
out/
# JetBrains library files
.idea_modules/

# Sublime Text
# --------
# Sublime Text workspace files
*.sublime-*
# Sublime Text cache
Packages/
# Sublime Text project files
*.sublime-project

# Vim
# --------
# Vim swap files
*.swo
*.swp
# Vim undo files
*.un~
# Vim session files
*.vim

# Emacs
# --------
# Emacs auto-save files
*~
\#*\#
# Emacs backup files
.#*
# Emacs tramp files
\#*#
# Emacs org-mode agenda files
.org-id-locations

# Atom
# --------
# Atom workspace
.atom/
# Atom build config
.buildlog

# Eclipse
# --------
# Eclipse workspace
.settings/
# Eclipse project files
.classpath
.project

# NetBeans
# --------
# NetBeans project directory
nbproject/
# NetBeans private configurations
nbproject/private/

# Notepad++ (if used)
# --------
# Notepad++ session file
session.vbs

# Cursor IDE
# --------
.cursor/


# =============================================================================
# 3. LANGUAGE AND FRAMEWORK SPECIFIC
# =============================================================================
# Patterns for specific programming languages and their ecosystems
# Uncomment sections relevant to your project

# -----------------------------------------------------------------------------
# Node.js / npm
# -----------------------------------------------------------------------------
# Dependencies directory (usually should be in .npmrc or package.json)
node_modules/
# npm debug log
npm-debug.log*
# npm cache
.npm
# Yarn
.yarn/
.yarn-integrity
# pnpm
.pnpm-store/
# Package lock files (optional - some projects prefer to commit these)
# package-lock.json
# yarn.lock (uncomment if using Yarn)
# pnpm-lock.yaml

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
# C extensions
*.so
# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
# Virtual environments
venv/
ENV/
env/
.venv/
# Virtual environment wrapper
.Python
env/
.venv
venv.bak/
# PyInstaller (compiled Python)
*.manifest
*.spec
# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
# MyPy
.mypy_cache/
.dmypy.json
dmypy.json
# Pyre
.pyre/
# Jupyter Notebook
.ipynb_checkpoints
# IPython
__pycache__/
# Flask
instance/
.webassets-cache
# Scrapy
.scrapy
# Sphinx documentation (if building docs)
docs/_build/

# -----------------------------------------------------------------------------
# Ruby / Jekyll
# -----------------------------------------------------------------------------
# Gems
vendor/bundle/
.bundle/
# Gemfile.lock (optional - often committed for production)
# Gemfile.lock
# Jekyll build output
_site/
# Jekyll metadata
.jekyll-cache/
.jekyll-metadata
# SASS cache
.sass-cache/
# Gem metadata (if using RubyGems)
gemfiles/*.lock
# rbenv / rvm
.rvm/
# Ruby version file
.ruby-version
# Ruby gemset
.ruby-gemset

# -----------------------------------------------------------------------------
# Java
# -----------------------------------------------------------------------------
# Compiled class files
*.class
# Log files
*.log
# BlueJ files
*.ctxt
# Mobile Tools for Java (J2ME)
.mtj.tmp/
# Package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
# Virtual machine crash logs
hs_err_pid*
replay_pid*
# Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar
# Gradle
.gradle/
# Gradle wrapper
gradle/wrapper/gradle-wrapper.jar
# Build output
build/
!gradle/wrapper/gradle-wrapper.jar
!src/main/**/build/
!src/test/**/build/

